
#root {
  min-height: 100vh;
}

.login-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
  min-height: 100vh;
  background: #fff;
}

.login-brand-panel {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 100vh;
  padding: 45px 8%;
  background: #1b304b;
  color: #fff;
}

.login-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.login-brand-mark {
  display: grid;
  flex: 0 0 42px;
  place-items: center;
  width: 42px;
  height: 42px;
  border: 1px solid rgb(255 255 255 / 20%);
  border-radius: 7px;
  background: rgb(255 255 255 / 9%);
  color: #fff;
}

.login-brand > div:last-child {
  display: grid;
  gap: 4px;
}

.login-brand strong {
  font: 800 15px "Manrope", sans-serif;
  letter-spacing: 1.5px;
}

.login-brand span {
  color: #a9b8ca;
  font-size: 9px;
  letter-spacing: 1.15px;
}

.brand-message {
  max-width: 530px;
  padding: 45px 0;
}

.brand-eyebrow,
.form-eyebrow {
  color: #9db6d3;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.8px;
}

.brand-message h1 {
  margin: 22px 0 18px;
  color: #fff;
  font: 700 clamp(31px, 3.5vw, 49px) "Manrope", sans-serif;
  letter-spacing: -1.8px;
  line-height: 1.22;
}

.brand-message h1 span {
  color: #9db8d7;
}

.brand-message > p {
  max-width: 390px;
  color: #bac7d7;
  font-size: 13px;
  line-height: 1.9;
}

.login-feature-list {
  display: grid;
  gap: 25px;
  margin-top: 43px;
}

.login-feature-list > div {
  display: flex;
  align-items: center;
  gap: 13px;
}

.feature-icon {
  display: grid;
  flex: 0 0 39px;
  place-items: center;
  width: 39px;
  height: 39px;
  border: 1px solid rgb(255 255 255 / 13%);
  border-radius: 6px;
  background: rgb(255 255 255 / 6%);
  color: #d5e2f0;
}

.login-feature-list > div > div {
  display: grid;
  gap: 5px;
}

.login-feature-list strong {
  color: #f0f4f9;
  font-size: 12px;
  font-weight: 600;
}

.login-feature-list > div > div > span {
  color: #a9b8ca;
  font-size: 11px;
}

.brand-footer {
  color: #95a7bd;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 1.2px;
}

.brand-footer span {
  padding: 0 5px;
}

.login-form-panel {
  display: grid;
  place-items: center;
  min-width: 0;
  padding: 40px 30px;
  background: #fff;
}

.login-form-container {
  width: 100%;
  max-width: 395px;
}

.login-mobile-brand {
  display: none;
}

.login-heading {
  margin-bottom: 34px;
}

.form-eyebrow {
  color: #6d87a6;
  font-size: 9px;
}

.login-heading h2 {
  margin: 13px 0 9px;
  color: #1d2d43;
  font: 700 27px "Manrope", sans-serif;
  letter-spacing: -0.8px;
}

.login-heading p {
  margin: 0;
  color: #7b899c;
  font-size: 12px;
  line-height: 1.7;
}

.login-form {
  display: grid;
  gap: 23px;
}

.form-field {
  display: grid;
  gap: 9px;
}

.form-field label {
  color: #34445a;
  font-size: 11px;
  font-weight: 600;
}

.input-wrapper {
  display: flex;
  align-items: center;
  gap: 11px;
  min-height: 46px;
  padding: 0 13px;
  border: 1px solid #dce3eb;
  border-radius: 5px;
  background: #fff;
  color: #8795a7;
  transition: border-color 150ms ease;
}

.input-wrapper:focus-within {
  border-color: #6c88a9;
  box-shadow: 0 0 0 3px rgb(79 117 158 / 9%);
}

.input-wrapper input {
  flex: 1;
  width: 100%;
  min-width: 0;
  height: 43px;
  padding: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: #253247;
  font-size: 12px;
}

.input-wrapper input:focus-visible {
  outline: 0;
}

.input-wrapper input::placeholder {
  color: #a2adba;
}

.password-toggle {
  display: grid;
  flex: 0 0 27px;
  place-items: center;
  width: 27px;
  height: 27px;
  padding: 0;
  border: 0;
  border-radius: 4px;
  background: transparent;
  color: #8492a4;
}

.password-toggle:hover {
  background: #f3f6f9;
}

.login-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  min-height: 46px;
  margin-top: 3px;
  border: 1px solid #203b5c;
  border-radius: 5px;
  background: #203b5c;
  color: #fff;
  font-size: 12px;
  font-weight: 600;
  transition: background 150ms ease;
}

.login-submit:hover:not(:disabled) {
  background: #294e76;
}

.login-submit:disabled {
  opacity: 0.65;
  cursor: wait;
}

.login-error {
  padding: 11px 12px;
  border: 1px solid #f0d5d5;
  border-radius: 5px;
  background: #fff5f5;
  color: #a13e3e;
  font-size: 11px;
  line-height: 1.6;
}

.login-security-note {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 29px;
  color: #8794a5;
  font-size: 10px;
  line-height: 1.6;
  text-align: center;
}

.login-security-note svg {
  flex: 0 0 auto;
  color: #64816f;
}

.login-copyright {
  margin-top: 47px;
  color: #a0aab7;
  font-size: 9px;
  text-align: center;
}

.login-success {
  padding: 23px;
  border: 1px solid #e0e8e2;
  border-radius: 7px;
  background: #fbfdfb;
  text-align: center;
}

.success-icon {
  display: grid;
  place-items: center;
  width: 51px;
  height: 51px;
  margin: 0 auto 16px;
  border-radius: 50%;
  background: #e8f3eb;
  color: #317451;
}

.login-success h3 {
  margin: 0 0 9px;
  color: #253c31;
  font: 700 18px "Manrope", sans-serif;
}

.login-success p {
  color: #718096;
  font-size: 11px;
  line-height: 1.8;
}

.login-success .next-step-note {
  padding: 10px;
  border-radius: 4px;
  background: #f0f4f8;
  color: #56677d;
}

.login-success .login-submit {
  margin-top: 20px;
}

@media (max-width: 850px) {
  .login-layout {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  .login-brand-panel {
    padding: 32px 7%;
  }

  .brand-message h1 {
    font-size: 34px;
  }

  .login-form-panel {
    padding: 30px 23px;
  }

  .login-heading h2 {
    font-size: 24px;
  }
}

@media (max-width: 620px) {
  .login-layout {
    grid-template-columns: minmax(0, 1fr);
  }

  .login-brand-panel {
    display: none;
  }

  .login-form-panel {
    min-height: 100vh;
    padding: 34px 23px;
  }

  .login-form-container {
    max-width: 410px;
  }

  .login-mobile-brand {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 54px;
    color: #203b5c;
    font: 800 14px "Manrope", sans-serif;
    letter-spacing: 1.3px;
  }

  .login-mobile-brand .login-brand-mark {
    flex-basis: 37px;
    width: 37px;
    height: 37px;
    background: #203b5c;
  }

  .login-heading {
    margin-bottom: 29px;
  }

  .login-heading h2 {
    font-size: 26px;
  }

  .login-copyright {
    margin-top: 40px;
  }
}

.session-loading {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 14px;
  background: #f5f7fa;
  color: #718096;
  font-size: 12px;
}

.session-loading-mark {
  display: grid;
  width: 42px;
  height: 42px;
  place-items: center;
  border-radius: 7px;
  background: #203b5c;
  color: #fff;
  font: 800 22px "Manrope", sans-serif;
}

.session-loading p {
  margin: 0;
}


/* Dashboard layout */
.app-shell {
  min-height: 100vh;
  background: #f5f7fa;
}

.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  z-index: 30;
  display: flex;
  flex-direction: column;
  width: 248px;
  padding: 25px 15px 14px;
  background: #fff;
  border-right: 1px solid #e2e8f0;
}

.main-area {
  min-height: 100vh;
  margin-left: 248px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  min-height: 46px;
  padding: 0 7px;
  margin-bottom: 39px;
}

.brand-mark {
  display: grid;
  flex: 0 0 39px;
  place-items: center;
  width: 39px;
  height: 39px;
  border-radius: 7px;
  background: #203b5c;
  color: #fff;
  font: 800 22px "Manrope", sans-serif;
}

.brand-copy {
  display: grid;
  gap: 4px;
}

.brand-copy strong {
  color: #172b45;
  font: 800 15px "Manrope", sans-serif;
  letter-spacing: 1.25px;
}

.brand-copy span {
  color: #9aa6b6;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 1px;
}

.workspace-label {
  padding: 0 12px;
  margin-bottom: 12px;
  color: #9aa5b4;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.25px;
}

.navigation {
  display: grid;
  gap: 5px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  width: 100%;
  min-height: 43px;
  padding: 0 12px;
  border: 1px solid transparent;
  border-radius: 6px;
  background: transparent;
  color: #647287;
  text-align: left;
  font-size: 12px;
  font-weight: 500;
}

.nav-item:hover {
  background: #f5f7fa;
  color: #203b5c;
}

.nav-item.nav-active {
  border-color: #e3eaf2;
  background: #edf2f8;
  color: #203b5c;
  font-weight: 700;
}

.nav-item > span:nth-child(2) {
  flex: 1;
}

.sidebar-bottom {
  margin-top: auto;
}

.sidebar-divider {
  height: 1px;
  margin: 0 6px 12px;
  background: #edf0f4;
}

.sidebar-profile {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 15px 5px 3px;
  border-top: 1px solid #edf0f4;
}

.profile-copy {
  display: grid;
  flex: 1;
  gap: 4px;
  min-width: 0;
}

.profile-copy strong {
  overflow: hidden;
  color: #2d3a4d;
  font-size: 11px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-copy span {
  color: #8b97a8;
  font-size: 10px;
}

.profile-menu {
  display: grid;
  place-items: center;
  width: 29px;
  height: 29px;
  border: 0;
  border-radius: 5px;
  background: transparent;
  color: #78869a;
}

.avatar {
  display: grid;
  flex: 0 0 35px;
  place-items: center;
  width: 35px;
  height: 35px;
  border: 1px solid #e3e9f0;
  border-radius: 6px;
  background: #f0f4f8;
  color: #405d7d;
  font-size: 10px;
  font-weight: 700;
}

.profile-avatar {
  background: #e9eef5;
  color: #203b5c;
}

/* Dashboard top bar */
.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  height: 69px;
  padding: 0 34px;
  border-bottom: 1px solid #e2e8f0;
  background: #fff;
}

.breadcrumb {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #8a96a8;
  font-size: 11px;
}

.breadcrumb strong {
  color: #34445a;
}

.topbar-right {
  display: flex;
  align-items: center;
  gap: 13px;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 9px;
  width: 235px;
  height: 36px;
  padding: 0 10px;
  border: 1px solid #dfe5ed;
  border-radius: 5px;
  background: #fff;
  color: #8491a3;
}

.search-box input {
  width: 100%;
  min-width: 0;
  padding: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: #253247;
  font-size: 11px;
}

.notification-button {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border: 1px solid #e1e6ed;
  border-radius: 5px;
  background: #fff;
  color: #5f6e82;
}

/* Dashboard content */
.page-content {
  width: 100%;
  max-width: 1600px;
  padding: 30px 34px 24px;
  margin: 0 auto;
}

.page-intro {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.eyebrow {
  margin-bottom: 9px;
  color: #8592a4;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.35px;
}

.page-intro h1 {
  margin: 0;
  color: #1d2d43;
  font: 700 25px "Manrope", sans-serif;
}

.page-description {
  margin: 8px 0 0;
  color: #7b899c;
  font-size: 12px;
  line-height: 1.7;
}

.demo-banner {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 12px 14px;
  margin-bottom: 20px;
  border: 1px solid #e0e7ef;
  border-radius: 5px;
  background: #f8fafc;
  color: #64748b;
  font-size: 11px;
  line-height: 1.6;
}

/* Dashboard buttons */
.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 36px;
  padding: 0 13px;
  border: 1px solid transparent;
  border-radius: 5px;
  font-size: 11px;
  font-weight: 600;
}

.button-primary {
  border-color: #203b5c;
  background: #203b5c;
  color: #fff;
}

.button-primary:hover {
  background: #294d75;
}

.button-secondary {
  border-color: #dce3eb;
  background: #fff;
  color: #42536a;
}

/* Statistics cards */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 15px;
  margin-bottom: 19px;
}

.stat-card {
  min-width: 0;
  padding: 18px;
  border: 1px solid #e2e8f0;
  border-radius: 7px;
  background: #fff;
}

.stat-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.stat-label {
  color: #728096;
  font-size: 11px;
}

.stat-icon {
  display: grid;
  flex: 0 0 34px;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 5px;
}

.stat-icon-blue {
  background: #edf2f8;
  color: #42648c;
}

.stat-icon-green {
  background: #eaf4ee;
  color: #36785b;
}

.stat-icon-orange {
  background: #f8f0e5;
  color: #a16f32;
}

.stat-icon-purple {
  background: #f0edf7;
  color: #735e9e;
}

.stat-value {
  margin-top: 17px;
  color: #1e2e43;
  font: 700 26px "Manrope", sans-serif;
}

.stat-footer {
  margin-top: 10px;
}

.stat-note {
  color: #8a96a7;
  font-size: 10px;
}

/* Panels and tables */
.panel {
  min-width: 0;
  border: 1px solid #e2e8f0;
  border-radius: 7px;
  background: #fff;
}

.page-panel {
  padding: 20px;
}

.page-panel h2,
.section-heading h2 {
  color: #24364c;
  font: 700 13px "Manrope", sans-serif;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
}

.section-heading p {
  color: #8996a7;
  font-size: 10px;
}

.table-container {
  width: 100%;
  overflow-x: auto;
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  text-align: left;
  white-space: nowrap;
}

.data-table thead {
  background: #f8fafc;
}

.data-table th {
  padding: 11px 9px;
  border-top: 1px solid #e8edf3;
  border-bottom: 1px solid #e8edf3;
  color: #738197;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.55px;
}

.data-table td {
  padding: 12px 9px;
  border-bottom: 1px solid #edf1f5;
  color: #5f6f83;
  font-size: 10px;
}

.login-error {
  padding: 11px 12px;
  border: 1px solid #f0d5d5;
  border-radius: 5px;
  background: #fff5f5;
  color: #a13e3e;
  font-size: 11px;
  line-height: 1.6;
}

/* Footer */
.app-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 16px 34px 20px;
  color: #95a0af;
  font-size: 9px;
}

/* Responsive layout */
@media (max-width: 1100px) {
  .sidebar {
    width: 220px;
  }

  .main-area {
    margin-left: 220px;
  }

  .page-content {
    padding-right: 22px;
    padding-left: 22px;
  }

  .topbar {
    padding-right: 22px;
    padding-left: 22px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 650px) {
  .sidebar {
    position: static;
    width: 100%;
    min-height: auto;
  }

  .main-area {
    margin-left: 0;
  }

  .topbar {
    position: static;
    padding: 0 15px;
  }

  .page-content {
    padding: 20px 15px;
  }

  .stats-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .app-footer {
    padding: 15px;
  }
}


/* Detailed dashboard sections */

.dashboard-grid,
.bottom-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.5fr) minmax(290px, 1fr);
  gap: 17px;
  margin-bottom: 17px;
}

.employee-panel,
.requests-panel,
.attendance-panel,
.payroll-panel {
  min-width: 0;
  padding: 20px;
}

.text-action {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 0;
  border: 0;
  background: transparent;
  color: #355c86;
  font-size: 10px;
  font-weight: 600;
  white-space: nowrap;
}

.text-action:hover {
  color: #203b5c;
}

.employee-identity {
  display: flex;
  align-items: center;
  gap: 9px;
}

.employee-identity > div:last-child {
  display: grid;
  gap: 4px;
}

.employee-identity strong {
  color: #2c3c52;
  font-size: 10px;
  font-weight: 700;
}

.employee-identity span {
  color: #8996a7;
  font-size: 9px;
}

.data-table tbody tr:last-child td {
  border-bottom: 0;
}

.data-table tbody tr:hover {
  background: #fafbfd;
}

.row-action,
.icon-button {
  display: grid;
  place-items: center;
  width: 29px;
  height: 29px;
  padding: 0;
  border: 1px solid transparent;
  border-radius: 4px;
  background: transparent;
  color: #8190a2;
}

.row-action:hover,
.icon-button:hover {
  border-color: #e2e8f0;
  background: #f7f9fb;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 7px;
  border: 1px solid transparent;
  border-radius: 4px;
  font-size: 9px;
  font-weight: 600;
  white-space: nowrap;
}

.status-dot {
  width: 5px;
  height: 5px;
  flex: 0 0 5px;
  border-radius: 50%;
  background: currentColor;
}

.status-active,
.status-approved,
.status-processed {
  border-color: #d8ebdf;
  background: #edf6f0;
  color: #317451;
}

.status-pending,
.status-on-leave {
  border-color: #f0e4ce;
  background: #fbf5e9;
  color: #986b2e;
}

.status-inactive,
.status-rejected {
  border-color: #f0dada;
  background: #fbefef;
  color: #a34747;
}

.leave-list {
  display: grid;
  margin-bottom: 13px;
}

.leave-item {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
  padding: 13px 0;
  border-bottom: 1px solid #edf1f5;
}

.leave-item:first-child {
  padding-top: 1px;
}

.leave-item:last-child {
  border-bottom: 0;
}

.leave-person {
  display: grid;
  flex: 1;
  gap: 4px;
  min-width: 0;
}

.leave-person strong {
  overflow: hidden;
  color: #2b3b51;
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.leave-person span {
  color: #68778c;
  font-size: 10px;
}

.leave-person small {
  color: #98a3b2;
  font-size: 9px;
}

.button-full {
  width: 100%;
}

.attendance-total {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12px;
  margin: 4px 0 23px;
}

.attendance-total > div {
  display: grid;
  gap: 5px;
}

.attendance-total > div strong {
  color: #20364e;
  font: 700 29px "Manrope", sans-serif;
}

.attendance-total > div span,
.attendance-count {
  color: #8996a7;
  font-size: 10px;
}

.attendance-count {
  text-align: right;
}

.department-list {
  display: grid;
  gap: 17px;
}

.department-row {
  display: grid;
  gap: 8px;
}

.department-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  color: #64748b;
  font-size: 10px;
}

.department-label strong {
  color: #43546a;
  font-size: 10px;
}

.progress-track {
  width: 100%;
  height: 6px;
  overflow: hidden;
  border-radius: 3px;
  background: #edf1f5;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
}

.fill-blue {
  background: #5a7da4;
}

.fill-green {
  background: #4f9473;
}

.fill-purple {
  background: #8774ad;
}

.fill-orange {
  background: #c19358;
}

.payroll-period {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  color: #7d8a9c;
  font-size: 10px;
}

.payroll-period strong {
  color: #52637a;
  font-weight: 600;
}

.payroll-amount {
  margin-top: 22px;
  color: #20344c;
  font: 700 30px "Manrope", sans-serif;
  letter-spacing: -0.9px;
}

.payroll-caption {
  margin-top: 6px;
  color: #8b97a7;
  font-size: 10px;
}

.payroll-breakdown {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  padding: 17px 0;
  margin-top: 19px;
  border-top: 1px solid #edf1f5;
  border-bottom: 1px solid #edf1f5;
}

.payroll-breakdown > div {
  display: grid;
  gap: 7px;
}

.payroll-breakdown span {
  color: #8995a5;
  font-size: 9px;
}

.payroll-breakdown strong {
  color: #34465c;
  font-size: 16px;
}

.payroll-note {
  display: flex;
  align-items: flex-start;
  gap: 7px;
  margin-top: 15px;
  color: #78869a;
  font-size: 10px;
  line-height: 1.5;
}

.payroll-note svg {
  flex: 0 0 auto;
  color: #4c8b6d;
}

.dashboard-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  min-height: 190px;
  padding: 20px;
  color: #8794a5;
  font-size: 11px;
  text-align: center;
}

.dashboard-empty strong {
  color: #34465c;
  font-size: 12px;
}

.dashboard-empty .button {
  margin-top: 5px;
}

.dashboard-error {
  padding: 12px;
  border: 1px solid #f0d5d5;
  border-radius: 5px;
  background: #fff5f5;
  color: #a13e3e;
  font-size: 11px;
  line-height: 1.6;
}

.selected-employee {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 13px;
  margin-top: 16px;
  border: 1px solid #e2e8f0;
  border-radius: 5px;
  background: #f8fafc;
}

.selected-employee > div {
  display: grid;
  gap: 5px;
  min-width: 0;
}

.selected-employee strong {
  color: #293b51;
  font-size: 11px;
}

.selected-employee span {
  color: #738197;
  font-size: 10px;
  overflow-wrap: anywhere;
}

.salary-value {
  color: #243e5c;
  font-size: 10px;
}

.dashboard-date {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #6c7b8f;
  font-size: 10px;
}

.search-clear {
  display: grid;
  flex: 0 0 23px;
  place-items: center;
  width: 23px;
  height: 23px;
  padding: 0;
  border: 0;
  border-radius: 4px;
  background: transparent;
  color: #718096;
}

.search-clear:hover {
  background: #f0f3f7;
}

@media (max-width: 1250px) {
  .dashboard-grid,
  .bottom-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (max-width: 760px) {
  .dashboard-grid,
  .bottom-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .employee-panel,
  .requests-panel,
  .attendance-panel,
  .payroll-panel {
    padding: 15px 12px;
  }

  .dashboard-date {
    align-self: flex-start;
  }
}


/* Add Employee form */
.employee-form {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
  margin-top: 24px;
}

.employee-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: var(--text-primary, #26364b);
  font-size: 13px;
  font-weight: 600;
}

.employee-form input {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  padding: 12px 14px;
  border: 1px solid #dce3ec;
  border-radius: 8px;
  background: #fff;
  color: #26364b;
  font: inherit;
  font-size: 13px;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.employee-form input:focus {
  border-color: #4f7fbd;
  box-shadow: 0 0 0 3px rgba(79, 127, 189, 0.12);
}

.employee-form input::placeholder {
  color: #9aa6b6;
  font-weight: 400;
}

.employee-form-actions {
  grid-column: 1 / -1;
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  padding-top: 8px;
  border-top: 1px solid #edf0f5;
}

@media (max-width: 640px) {
  .employee-form {
    grid-template-columns: 1fr;
  }

  .employee-form-actions {
    grid-column: 1;
  }
}


/* Align Employees header actions */
.page-intro {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.page-intro > div:first-child {
  min-width: 0;
}

.page-intro > button {
  flex-shrink: 0;
  align-self: center;
}

/* Consistent spacing between header buttons */
.page-intro .button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 38px;
  white-space: nowrap;
}

@media (max-width: 640px) {
  .page-intro {
    flex-wrap: wrap;
  }

  .page-intro > button {
    margin-left: auto;
  }
}

.employee-header-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  flex-wrap: wrap;
}

/* HRMS notification panel */
.notification-wrapper {
  position: relative;
  flex-shrink: 0;
}

.notification-button {
  position: relative;
  cursor: pointer;
  transition: background 0.2s ease, border-color 0.2s ease;
}

.notification-button:hover,
.notification-button:focus-visible {
  background: #f4f7fb;
  border-color: #b8c7dc;
  outline: none;
}

.notification-dot {
  position: absolute;
  top: 6px;
  right: 6px;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #e05260;
  box-shadow: 0 0 0 2px #fff;
}

.notification-panel {
  position: absolute;
  z-index: 1000;
  top: calc(100% + 12px);
  right: 0;
  width: min(360px, calc(100vw - 32px));
  max-height: 440px;
  overflow-y: auto;
  padding: 16px;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 16px 42px rgba(25, 42, 70, 0.16);
  color: #253247;
}

.notification-panel-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 12px;
  border-bottom: 1px solid #edf0f5;
}

.notification-panel-heading strong {
  font-size: 14px;
  font-weight: 700;
}

.notification-message {
  margin: 0;
  padding: 20px 4px;
  color: #718096;
  font-size: 12px;
  line-height: 1.6;
}

.notification-message p {
  margin: 0 0 10px;
}

.notification-list {
  display: flex;
  flex-direction: column;
}

.notification-item {
  display: flex;
  align-items: flex-start;
  gap: 11px;
  padding: 14px 2px;
  border-bottom: 1px solid #edf0f5;
}

.notification-item-icon {
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  flex-shrink: 0;
  border-radius: 8px;
  background: #edf4ff;
  color: #3568b8;
}

.notification-item strong {
  display: block;
  margin-bottom: 4px;
  color: #253247;
  font-size: 12px;
}

.notification-item p,
.notification-item span {
  display: block;
  margin: 0;
  color: #718096;
  font-size: 11px;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.notification-view-all {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  width: 100%;
  margin-top: 12px;
  padding: 10px;
  border: 1px solid #e1e8f1;
  border-radius: 6px;
  background: #f7f9fc;
  color: #315d9b;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}

.notification-view-all:hover {
  background: #edf4ff;
}

@media (max-width: 480px) {
  .notification-panel {
    right: -4px;
  }
}



/* Reports and leave-review controls */
.report-panel { margin-bottom: 20px; }
.report-filter-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
  gap: 16px;
  margin: 18px 0;
}
.report-filter-grid label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-secondary, #64748b);
}
.report-filter-grid input {
  width: 100%;
  min-height: 42px;
  padding: 10px 12px;
  border: 1px solid var(--border, #dbe2ea);
  border-radius: 9px;
  background: var(--surface, #fff);
  color: inherit;
  font: inherit;
}
.report-feedback {
  padding: 12px 15px;
  border-radius: 9px;
  margin: 0 0 16px;
  font-size: 14px;
}
.report-success {
  color: #166534;
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
}
.leave-review-actions { display: flex; gap: 8px; flex-wrap: wrap; }
.button-small { padding: 7px 10px; font-size: 12px; }
.button:disabled { opacity: .6; cursor: not-allowed; }
.report-muted { color: #64748b; font-size: 12px; }
